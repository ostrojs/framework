{
    "name": "@ostro/framework",
    "version": "2.0.0-alpha.1",
    "description": "MVC framework for NodeJS",
    "main": "build/index.js",
    "types": "build/index.d.ts",
    "exports": {
        ".": {
            "types": "./build/index.d.ts",
            "default": "./build/index.js"
        },
        "./*": {
            "types": "./build/*.d.ts",
            "default": "./build/*.js"
        }
    },
    "scripts": {
        "test": "npx c8 npx jest",
        "build": "rm -rf build && npx tsc -p tsconfig.build.json && node scripts/build.js",
        "prepublishOnly": "npm run build",
        "clean": "rm -rf build coverage"
    },
    "dependencies": {
        "@ostro/auth": "^2.0.0-alpha.1",
        "@ostro/cache": "^2.0.0-alpha.1",
        "@ostro/config": "^2.0.0-alpha.1",
        "@ostro/console": "^2.0.0-alpha.1",
        "@ostro/container": "^2.0.0-alpha.1",
        "@ostro/contracts": "^2.0.0-alpha.1",
        "@ostro/cookie": "^2.0.0-alpha.1",
        "@ostro/database": "^2.0.0-alpha.1",
        "@ostro/encryption": "^2.0.0-alpha.1",
        "@ostro/filesystem": "^2.0.0-alpha.1",
        "@ostro/http": "^2.0.0-alpha.1",
        "@ostro/logger": "^2.0.0-alpha.1",
        "@ostro/router": "^2.0.0-alpha.1",
        "@ostro/session": "^2.0.0-alpha.1",
        "@ostro/server": "^2.0.0-alpha.1",
        "@ostro/serverless": "^2.0.0-alpha.1",
        "@ostro/support": "^2.0.0-alpha.1",
        "@ostro/validation": "^2.0.0-alpha.1",
        "@ostro/view": "^2.0.0-alpha.1",
        "@ostro/foundation": "^2.0.0-alpha.1"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "engineStrict": true,
    "keywords": [
        "ostrojs",
        "framework",
        "nodejs framework",
        "mvc",
        "framework"
    ],
    "author": "amar",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ostrojs/framework.git"
    },
    "bugs": {
        "url": "https://github.com/ostrojs/framework/issues"
    },
    "homepage": "https://github.com/ostrojs/framework#readme",
    "files": [
        "build",
        "package.json",
        "README.md",
        "LICENSE"
    ],
    "devDependencies": {
        "typescript": "^5.8.0",
        "@types/node": "^22.0.0"
    }
}
