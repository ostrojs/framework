{
    "name": "@ostro/framework",
    "version": "2.0.0-alpha.5",
    "description": "MVC framework for NodeJS",
    "main": "index.js",
    "types": ".typed/index.d.ts",
    "exports": {
        ".": {
            "types": "./.typed/index.d.ts",
            "default": "./index.js"
        },
        "./*": {
            "types": "./.typed/*.d.ts",
            "default": "./*.js"
        }
    },
    "scripts": {
        "test": "jest",
        "build": "npm run lint:check && rm -rf build && ostro-build --prepare",
        "prepublishOnly": "npm run build",
        "clean": "rm -rf build coverage",
        "lint:check": "tsc --noEmit"
    },
    "dependencies": {
        "@ostro/auth": "^2.0.0-alpha.4",
        "@ostro/cache": "^2.0.0-alpha.3",
        "@ostro/config": "^2.0.0-alpha.3",
        "@ostro/console": "^2.0.0-alpha.3",
        "@ostro/container": "^2.0.0-alpha.3",
        "@ostro/contracts": "^2.0.0-alpha.3",
        "@ostro/cookie": "^2.0.0-alpha.4",
        "@ostro/database": "^2.0.0-alpha.6",
        "@ostro/encryption": "^2.0.0-alpha.3",
        "@ostro/filesystem": "^2.0.0-alpha.3",
        "@ostro/foundation": "^2.0.0-alpha.4",
        "@ostro/http": "^2.0.0-alpha.3",
        "@ostro/logger": "^2.0.0-alpha.3",
        "@ostro/router": "^2.0.0-alpha.4",
        "@ostro/server": "^2.0.0-alpha.3",
        "@ostro/serverless": "^2.0.0-alpha.3",
        "@ostro/session": "^2.0.0-alpha.3",
        "@ostro/support": "^2.0.0-alpha.3",
        "@ostro/validation": "^2.0.0-alpha.3",
        "@ostro/view": "^2.0.0-alpha.3"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "engineStrict": true,
    "keywords": [
        "ostrojs",
        "framework",
        "nodejs framework",
        "mvc",
        "framework"
    ],
    "author": "amar",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ostrojs/framework.git"
    },
    "bugs": {
        "url": "https://github.com/ostrojs/framework/issues"
    },
    "homepage": "https://github.com/ostrojs/framework#readme",
    "devDependencies": {
        "@ostro/builder": "^2.0.0-alpha.1",
        "@types/jest": "^30.0.0",
        "@types/node": "^22.0.0",
        "c8": "^10.1.3",
        "jest": "^30.5.2",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.0"
    },
    "overrides": {
        "sprintf-js": "^1.1.3",
        "braces": "^3.0.3",
        "argparse": "^2.0.1",
        "js-yaml": "^4.1.0"
    }
}
